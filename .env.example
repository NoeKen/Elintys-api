# Serveur
PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
# Environnement métier et données: dev ou prod (indépendant de NODE_ENV)
ELINTYS_ENV=dev
ENABLE_SWAGGER=false

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elintys?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Ouverture du paiement participant. Fail-closed: laisser vide ou false.
PAID_CHECKOUT_ENABLED=false

# Billetterie payante (Vague 5)
# Durée de la réservation temporaire de stock, en minutes (1 à 120).
# Valeur DEV par défaut si absente: 15 — à confirmer par une décision produit.
PAID_TICKET_HOLD_MINUTES=15
# Fournisseur de paiement SIMULÉ (développement uniquement).
# L'API REFUSE DE DÉMARRER si ce drapeau vaut true hors ELINTYS_ENV=dev.
TEST_PAYMENT_PROVIDER_ENABLED=false

# PayPal — pilote par configuration
#
# PAYPAL_ENV choisit l'environnement de paiement : sandbox | live.
# Il est INDEPENDANT de NODE_ENV et d'ELINTYS_ENV. Un build de production peut
# viser Sandbox ; un environnement de developpement ne bascule jamais en Live
# tout seul. Absent ou invalide => refus de demarrage (ou sandbox si absent).
#
# Passer de Sandbox a Live ne demande AUCUNE modification de code : seules ces
# variables changent, avec les credentials et le webhook correspondants.
#
# Trois interrupteurs doivent etre alignes pour qu'un paiement soit possible :
#   PAID_CHECKOUT_ENABLED=true   (le domaine accepte les commandes payantes)
#   PAYPAL_PROVIDER_ENABLED=true (le fournisseur PayPal est selectionnable)
#   credentials completes        (sinon refus de demarrage, jamais de repli)
PAYPAL_PROVIDER_ENABLED=false
PAYPAL_ENV=sandbox
# Identifiants d'application PayPal Developer. Placeholders uniquement.
# Sandbox et Live ont des credentials DISTINCTS : ne jamais les melanger.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Identifiant du webhook cree dans le tableau de bord PayPal Developer.
# Sandbox et Live ont chacun leur propre webhook.
PAYPAL_WEBHOOK_ID=

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=Elintys <noreply@elintys.ca>
# Laisser à true hors suites E2E locales.
EMAIL_DELIVERY_ENABLED=true

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dérivé strictement de ELINTYS_ENV : Elintys/dev/... ou Elintys/prod/...

# Anthropic (Phase 2)
ANTHROPIC_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Toujours omettre: les cookies d'authentification sont host-only.
COOKIE_DOMAIN=
