# Serveur
PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
# Environnement métier et données: dev ou prod (indépendant de NODE_ENV)
ELINTYS_ENV=dev
ENABLE_SWAGGER=false

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/elintys?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Ouverture du paiement participant. Fail-closed: laisser vide ou false.
PAID_CHECKOUT_ENABLED=false

# Billetterie payante (Vague 5)
# Durée de la réservation temporaire de stock, en minutes (1 à 120).
# Valeur DEV par défaut si absente: 15 — à confirmer par une décision produit.
PAID_TICKET_HOLD_MINUTES=15
# Fournisseur de paiement SIMULÉ (développement uniquement).
# L'API REFUSE DE DÉMARRER si ce drapeau vaut true hors ELINTYS_ENV=dev.
TEST_PAYMENT_PROVIDER_ENABLED=false

# PayPal — Vague 6 (SANDBOX UNIQUEMENT)
# L'API REFUSE DE DEMARRER si PAYPAL_ENV=live, quel que soit l'environnement.
# PayPal exige AUSSI PAID_CHECKOUT_ENABLED=true pour etre selectionne (double interrupteur).
PAYPAL_PROVIDER_ENABLED=false
PAYPAL_ENV=sandbox
# Identifiants d'application PayPal Developer (Sandbox). Placeholders uniquement.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Identifiant du webhook cree dans le tableau de bord PayPal Developer.
PAYPAL_WEBHOOK_ID=

# Resend
RESEND_API_KEY=re_...
EMAIL_FROM=Elintys <noreply@elintys.ca>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dérivé strictement de ELINTYS_ENV : Elintys/dev/... ou Elintys/prod/...

# Anthropic (Phase 2)
ANTHROPIC_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
# Toujours omettre: les cookies d'authentification sont host-only.
COOKIE_DOMAIN=
